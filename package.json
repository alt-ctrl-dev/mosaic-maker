{
	"name": "mosaic-maker",
	"private": true,
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome lint .",
		"format": "biome format .",
		"test": "vitest run",
		"typecheck": "tsc -b",
		"check": "pnpm run lint && pnpm run format && pnpm run test && pnpm run typecheck",
		"sandcastle": "node --env-file=.sandcastle/.env .sandcastle/sandcastle-bot/main.mts",
		"sandcastle-playground": "node .sandcastle/playground.mts",
		"sandcastle-pr-creator": "node --env-file=.sandcastle/.env .sandcastle/pr-creator-bot/pr-creator.mts",
		"sandcastle-pr-bot": "node --env-file=.sandcastle/.env .sandcastle/pr-bot/main.mts",
		"sandcastle-triage-bot": "node --env-file=.sandcastle/.env .sandcastle/triage-bot/main.mts",
		"sandcastle-build-image": "pnpx @ai-hero/sandcastle docker build-image",
		"sandcastle-cleanup": "node .sandcastle/cleanup-bot/main.mts",
		"prototype-neighbor-avoidance": "vite --config vite.prototype.config.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@grafana/faro-web-sdk": "2.12.0",
		"@picocss/pico": "2.1.1",
		"jotai": "3.0.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@ai-hero/sandcastle": "0.12.0",
		"@biomejs/biome": "2.5.14",
		"@grafana/faro-rollup-plugin": "0.12.0",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.1.1",
		"husky": "9.1.7",
		"jsdom": "30.1.0",
		"lint-staged": "17.3.0",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	},
	"version": "1.0.0"
}
